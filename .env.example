# Copy to .env for local testing with `vercel dev`. Never commit the real .env file.
# On Vercel, set these under Project Settings > Environment Variables instead.

MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority

# SESSION_SECRET: a random string of at least 32 characters used to sign login sessions.
# Without it, nobody can log in (and no data is served).
SESSION_SECRET=change-me-to-a-long-random-string

# ADMIN_PASSWORD is used ONCE, for first-run setup: while no accounts exist, logging in as
# the username "admin" with this password creates the first admin account. After that the
# password lives (hashed) in the database and this variable is no longer used.
ADMIN_PASSWORD=change-me

# Optional (these are the defaults)
MONGODB_DB=LabAttendanceDB_Millar
MONGODB_COLLECTION=attendance_records
MONGODB_USERS_COLLECTION=users
MONGODB_AUDIT_COLLECTION=audit_log
